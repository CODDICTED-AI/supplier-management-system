# ── Site ────────────────────────────────────────────────────────────────
# Public URL of the deployed site (used for canonical links, hreflang, sitemap).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Contact channels shown on the site (leave empty to hide a channel) ───
NEXT_PUBLIC_CONTACT_EMAIL=
# Digits only, with country code, e.g. 8613800000000
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_WECHAT_ID=

# ── Inquiry form delivery (configure at least one for production) ────────
# 1) Generic JSON webhook (your CRM, n8n, Make, Zapier, …)
INQUIRY_WEBHOOK_URL=
# Optional shared secret, sent as the "X-Webhook-Secret" header
INQUIRY_WEBHOOK_SECRET=

# 2) E-mail via Resend (https://resend.com)
RESEND_API_KEY=
# Where inquiries are delivered
INQUIRY_TO_EMAIL=
# Verified sender, e.g. "YiLu Health <inquiries@your-domain.com>"
INQUIRY_FROM_EMAIL=
